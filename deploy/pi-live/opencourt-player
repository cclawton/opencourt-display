#!/usr/bin/python3
"""Run one kiosk browser and switch its top-level source when config changes."""

from __future__ import annotations

import json
import hashlib
import os
import platform
from pathlib import Path
import signal
import shutil
import socket
import subprocess
import sys
import time
from datetime import datetime
from threading import Event
from typing import Any
from urllib.error import HTTPError
from urllib.parse import parse_qsl, urlencode, urlparse, urlunparse
from urllib.request import Request, urlopen
from zoneinfo import ZoneInfo

CONTENT_DIR = Path(os.environ.get("OPENCOURT_CONTENT_DIR", "/var/lib/opencourt"))
CONFIG_PATH = Path(os.environ.get("OPENCOURT_CONFIG", CONTENT_DIR / "device-config.json"))
REMOTE_PATH = Path(os.environ.get("OPENCOURT_REMOTE", CONTENT_DIR / "remote.json"))
CHROMIUM = os.environ.get("OPENCOURT_CHROMIUM", "/usr/bin/chromium")
MAX_CONFIG_BYTES = 128 * 1024
MAX_IMAGE_BYTES = 20 * 1024 * 1024
MAX_IMAGE_PIXELS = 16_777_216
MAX_CONFIG_IMAGE_BYTES = 100 * 1024 * 1024
MAX_CONFIG_IMAGE_PIXELS = 64_000_000
ASSET_DIR = CONTENT_DIR / "assets"
STOP = Event()


def report_local_health(browser: Any, active_url: str | None) -> None:
    """Signal only after configuration was loaded and Chromium is alive."""
    path = os.environ.get("OPENCOURT_HEALTH_FILE")
    token = os.environ.get("OPENCOURT_HEALTH_TOKEN")
    if not path or not token or not active_url or browser is None or browser.poll() is not None:
        return
    destination = Path(path)
    temporary = destination.with_suffix(".tmp")
    temporary.write_text(json.dumps({"pid": os.getpid(), "token": token,
                                     "monotonic": time.monotonic()}))
    temporary.replace(destination)


class ConfigError(ValueError):
    """The candidate configuration is unsafe or unsupported."""


def config_revision(config: dict[str, Any], label: str = "configuration") -> int:
    revision = config.get("revision")
    if isinstance(revision, bool) or not isinstance(revision, int) or revision < 1:
        raise ConfigError(f"{label} revision must be a positive integer")
    return revision


def load_config(path: Path = CONFIG_PATH) -> dict[str, Any]:
    config = json.loads(path.read_text(encoding="utf-8"))
    if config.get("schemaVersion") != 1:
        raise ConfigError("schemaVersion must be 1")
    config_revision(config)
    if not isinstance(config.get("source"), dict):
        raise ConfigError("source is required")
    if config.get("mode", "manual") == "schedule":
        validate_schedule(config.get("schedule"))
    elif config.get("mode", "manual") != "manual":
        raise ConfigError("mode must be manual or schedule")
    return config


def time_minutes(value: str) -> int:
    if not isinstance(value, str) or len(value) != 5 or value[2] != ":":
        raise ConfigError("schedule time is invalid")
    try:
        hours, minutes = (int(part) for part in value.split(":"))
    except ValueError as error:
        raise ConfigError("schedule time is invalid") from error
    if not 0 <= hours <= 23 or not 0 <= minutes <= 59:
        if hours == 24 and minutes == 0:
            return 24 * 60
        raise ConfigError("schedule time is invalid")
    return hours * 60 + minutes


def validate_schedule(schedule: Any) -> None:
    if not isinstance(schedule, dict) or schedule.get("timezone") != "Australia/Melbourne":
        raise ConfigError("schedule timezone is invalid")
    fallback = schedule.get("fallback")
    entries = schedule.get("entries")
    if not isinstance(fallback, dict) or not isinstance(fallback.get("source"), dict) or not isinstance(entries, list):
        raise ConfigError("schedule is invalid")
    previous: dict[str, int] = {}
    for entry in entries:
        if not isinstance(entry, dict) or entry.get("day") not in {"Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"} or not isinstance(entry.get("source"), dict):
            raise ConfigError("schedule entry is invalid")
        start = time_minutes(entry.get("startTime"))
        end = time_minutes(entry.get("endTime"))
        if start >= end or start < previous.get(entry["day"], -1):
            raise ConfigError("schedule windows overlap or are invalid")
        previous[entry["day"]] = end


def scheduled_source(config: dict[str, Any], current_time: datetime | None = None) -> dict[str, Any]:
    if config.get("mode", "manual") != "schedule":
        return config["source"]
    schedule = config["schedule"]
    validate_schedule(schedule)
    now = current_time or datetime.now(ZoneInfo(schedule["timezone"]))
    minute = now.hour * 60 + now.minute
    day = now.strftime("%A")
    for entry in schedule["entries"]:
        if entry["day"] == day and time_minutes(entry["startTime"]) <= minute < time_minutes(entry["endTime"]):
            return entry["source"]
    return schedule["fallback"]["source"]


def load_remote_settings(path: Path = REMOTE_PATH) -> dict[str, str] | None:
    settings = json.loads(path.read_text(encoding="utf-8"))
    if settings.get("schemaVersion") != 1:
        raise ConfigError("remote schemaVersion must be 1")

    device_id = str(settings.get("deviceId", "")).strip()
    config_url = str(settings.get("configUrl", "")).strip()
    status_url = str(settings.get("statusUrl", "")).strip()
    status_token = str(settings.get("statusToken", "")).strip()
    if not device_id:
        raise ConfigError("remote deviceId is required")
    if not config_url:
        return None

    parsed = urlparse(config_url)
    allow_http = os.environ.get("OPENCOURT_ALLOW_HTTP") == "1"
    if parsed.scheme != "https" and not (allow_http and parsed.scheme == "http"):
        raise ConfigError("remote config URL must use HTTPS")
    if not parsed.netloc or parsed.username or parsed.password:
        raise ConfigError("remote config URL is invalid")

    if status_url:
        parsed_status = urlparse(status_url)
        if parsed_status.scheme != "https" or not parsed_status.netloc:
            raise ConfigError("remote status URL must use HTTPS")
        if len(status_token) < 32:
            raise ConfigError("remote status token is invalid")

    return {
        "deviceId": device_id,
        "configUrl": config_url,
        "statusUrl": status_url,
        "statusToken": status_token,
    }


def _read_text(path: str, fallback: str = "") -> str:
    try:
        return Path(path).read_text(encoding="utf-8").replace("\x00", "").strip()
    except OSError:
        return fallback


def _primary_ip() -> str:
    connection = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        connection.connect(("1.1.1.1", 53))
        return str(connection.getsockname()[0])
    except OSError:
        return ""
    finally:
        connection.close()


def device_diagnostics() -> dict[str, Any]:
    os_name = ""
    for line in _read_text("/etc/os-release").splitlines():
        if line.startswith("PRETTY_NAME="):
            os_name = line.split("=", 1)[1].strip('"')
            break
    memory_kib = 0
    for line in _read_text("/proc/meminfo").splitlines():
        if line.startswith("MemTotal:"):
            memory_kib = int(line.split()[1])
            break
    try:
        uptime_seconds = int(float(_read_text("/proc/uptime", "0").split()[0]))
    except (ValueError, IndexError):
        uptime_seconds = 0
    storage = shutil.disk_usage("/")
    return {
        "capabilities": {"local_image_slideshow": 1},
        "hardware": {
            "model": _read_text("/proc/device-tree/model", platform.machine()),
            "architecture": platform.machine(),
            "cpuCount": os.cpu_count() or 0,
            "memoryMiB": round(memory_kib / 1024),
            "storageTotalGiB": round(storage.total / (1024**3), 1),
            "storageFreeGiB": round(storage.free / (1024**3), 1),
        },
        "system": {
            "hostname": socket.gethostname(),
            "operatingSystem": os_name or platform.system(),
            "kernel": platform.release(),
            "uptimeSeconds": uptime_seconds,
            "playerVersion": "2026-10-18",
        },
        "network": {"primaryIp": _primary_ip()},
    }


def report_device_status(
    settings: dict[str, str], revision: int | None, opener: Any = None
) -> None:
    if not settings.get("statusUrl"):
        return
    payload = device_diagnostics()
    payload["revision"] = revision
    request = Request(
        settings["statusUrl"],
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {settings['statusToken']}",
            "Content-Type": "application/json",
            "User-Agent": "OpenCourt-Display/0.1",
        },
        method="POST",
    )
    open_request = opener or urlopen
    with open_request(request, timeout=15) as response:
        if response.status != 200:
            raise ConfigError("device status report was rejected")


def fetch_remote_config(
    settings: dict[str, str],
    etag: str | None,
    opener: Any = None,
) -> tuple[dict[str, Any] | None, str | None]:
    headers = {"Accept": "application/json", "User-Agent": "OpenCourt-Display/0.1"}
    if etag:
        headers["If-None-Match"] = etag
    request = Request(settings["configUrl"], headers=headers)
    open_request = opener or urlopen

    try:
        with open_request(request, timeout=10) as response:
            content_length = response.headers.get("Content-Length")
            if content_length and int(content_length) > MAX_CONFIG_BYTES:
                raise ConfigError("remote config is too large")
            payload = response.read(MAX_CONFIG_BYTES + 1)
            if len(payload) > MAX_CONFIG_BYTES:
                raise ConfigError("remote config is too large")
            candidate = json.loads(payload.decode("utf-8"))
            response_etag = response.headers.get("ETag")
    except HTTPError as error:
        if error.code == 304:
            return None, etag
        raise

    validate_remote_config(candidate, settings["deviceId"])
    prepare_config(candidate)
    return candidate, response_etag


def validate_remote_config(config: dict[str, Any], device_id: str) -> None:
    if config.get("schemaVersion") != 1:
        raise ConfigError("remote config schemaVersion must be 1")
    if str(config.get("deviceId", "")) != device_id:
        raise ConfigError("remote config deviceId does not match this display")
    config_revision(config, "remote configuration")
    if not isinstance(config.get("source"), dict):
        raise ConfigError("remote config source is required")
    if config.get("mode", "manual") == "schedule":
        validate_schedule(config.get("schedule"))


def write_config_atomically(config: dict[str, Any], path: Path = CONFIG_PATH) -> None:
    temporary_path = path.with_suffix(f"{path.suffix}.tmp")
    temporary_path.write_text(f"{json.dumps(config, indent=2)}\n", encoding="utf-8")
    temporary_path.chmod(0o644)
    temporary_path.replace(path)


def require_newer_remote_revision(
    remote_config: dict[str, Any],
    local_config: dict[str, Any] | None,
) -> None:
    if local_config is None:
        return

    remote_revision = config_revision(remote_config, "remote configuration")
    local_revision = config_revision(local_config, "local configuration")
    if remote_revision <= local_revision:
        raise ConfigError(
            f"remote revision {remote_revision} is not newer than local revision {local_revision}"
        )


def google_slides_url(value: str) -> str:
    parsed = urlparse(value.strip())
    if parsed.scheme != "https" or parsed.netloc != "docs.google.com":
        raise ConfigError("Google Slides URL must use https://docs.google.com")

    parts = [part for part in parsed.path.split("/") if part]
    if len(parts) < 4 or parts[:2] != ["presentation", "d"]:
        raise ConfigError("Google Slides presentation path is invalid")

    if parts[2] == "e":
        if len(parts) < 5:
            raise ConfigError("published presentation ID is missing")
        path = f"/presentation/d/e/{parts[3]}/embed"
    else:
        path = f"/presentation/d/{parts[2]}/preview"

    query = dict(parse_qsl(parsed.query, keep_blank_values=True))
    query.update({"start": "true", "loop": "true", "delayms": "10000", "rm": "minimal"})
    return urlunparse(("https", "docs.google.com", path, "", urlencode(query), ""))


def image_dimensions(payload: bytes) -> tuple[int, int]:
    if payload.startswith(b"\x89PNG\r\n\x1a\n") and len(payload) >= 24:
        return int.from_bytes(payload[16:20], "big"), int.from_bytes(payload[20:24], "big")

    if payload.startswith(b"\xff\xd8"):
        offset = 2
        start_of_frame = {0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7, 0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF}
        while offset + 9 < len(payload):
            if payload[offset] != 0xFF:
                offset += 1
                continue
            while offset < len(payload) and payload[offset] == 0xFF:
                offset += 1
            if offset >= len(payload):
                break
            marker = payload[offset]
            offset += 1
            if marker in {0xD8, 0xD9}:
                continue
            if offset + 2 > len(payload):
                break
            segment_length = int.from_bytes(payload[offset:offset + 2], "big")
            if segment_length < 2 or offset + segment_length > len(payload):
                break
            if marker in start_of_frame and segment_length >= 7:
                return (
                    int.from_bytes(payload[offset + 5:offset + 7], "big"),
                    int.from_bytes(payload[offset + 3:offset + 5], "big"),
                )
            offset += segment_length

    raise ConfigError("downloaded image is not a supported JPEG or PNG")


def validate_image_payload(payload: bytes, source: dict[str, Any]) -> tuple[int, int]:
    if len(payload) > MAX_IMAGE_BYTES:
        raise ConfigError("image is too large")
    width, height = image_dimensions(payload)
    if width < 1 or height < 1 or width * height > MAX_IMAGE_PIXELS:
        raise ConfigError("image pixel dimensions exceed player limits")
    for key, actual in [("expectedWidth", width), ("expectedHeight", height)]:
        if source.get(key) and actual != int(source[key]):
            raise ConfigError(f"image {key} {actual} does not match {source[key]}")
    expected_sha256 = str(source.get("sha256", "")).lower()
    if expected_sha256 and hashlib.sha256(payload).hexdigest() != expected_sha256:
        raise ConfigError("image checksum does not match")
    return width, height


def cache_remote_image(
    source: dict[str, Any],
    revision: str,
    opener: Any = None,
) -> str:
    url = str(source.get("url", "")).strip()
    parsed = urlparse(url)
    if parsed.scheme != "https" or not parsed.netloc or parsed.username or parsed.password:
        raise ConfigError("remote image URL must use HTTPS")

    suffix = Path(parsed.path).suffix.lower()
    if suffix not in {".jpg", ".jpeg", ".png"}:
        raise ConfigError("remote image must be a JPEG or PNG")
    digest = str(source.get("sha256", "")).lower()
    identity = digest or revision
    cache_name = f"{hashlib.sha256(f'{url}|{identity}'.encode()).hexdigest()[:24]}{suffix}"
    relative_name = f"assets/{cache_name}"
    target = ASSET_DIR / cache_name
    if target.is_file():
        with target.open("rb") as cached:
            validate_image_payload(cached.read(MAX_IMAGE_BYTES + 1), source)
        return relative_name
    # Older players keyed by revision. Preserve offline upgrades and rollbacks:
    # verify and reference that existing file rather than requiring a download.
    legacy_name = f"{hashlib.sha256(f'{url}|{revision}'.encode()).hexdigest()[:24]}{suffix}"
    legacy_target = ASSET_DIR / legacy_name
    if digest and legacy_target.is_file():
        with legacy_target.open("rb") as cached:
            payload = cached.read(MAX_IMAGE_BYTES + 1)
        validate_image_payload(payload, source)
        temporary = target.with_suffix(f"{target.suffix}.tmp")
        temporary.write_bytes(payload)
        temporary.chmod(0o644)
        temporary.replace(target)
        return relative_name

    request = Request(url, headers={"Accept": "image/jpeg,image/png", "User-Agent": "OpenCourt-Display/0.1"})
    open_request = opener or urlopen
    with open_request(request, timeout=20) as response:
        content_length = response.headers.get("Content-Length")
        if content_length and int(content_length) > MAX_IMAGE_BYTES:
            raise ConfigError("remote image is too large")
        content_type = response.headers.get("Content-Type", "").split(";", 1)[0].strip().lower()
        if content_type not in {"image/jpeg", "image/png"}:
            raise ConfigError("remote image content type is invalid")
        payload = response.read(MAX_IMAGE_BYTES + 1)
    if len(payload) > MAX_IMAGE_BYTES:
        raise ConfigError("remote image is too large")

    validate_image_payload(payload, source)

    ASSET_DIR.mkdir(mode=0o755, parents=True, exist_ok=True)
    temporary = target.with_suffix(f"{target.suffix}.tmp")
    temporary.write_bytes(payload)
    temporary.chmod(0o644)
    temporary.replace(target)
    return relative_name


def image_player_url(source: dict[str, Any], revision: str) -> str:
    value = str(source.get("url", "")).strip()
    relative_name = cache_remote_image(source, revision) if value.startswith("https://") else value
    relative_path = Path(relative_name)
    if not relative_name or relative_path.is_absolute() or ".." in relative_path.parts:
        raise ConfigError("image URL must be a safe local filename or HTTPS URL")
    if len(relative_path.parts) > 2 or (len(relative_path.parts) == 2 and relative_path.parts[0] != "assets"):
        raise ConfigError("image cache path is invalid")

    image_path = (CONTENT_DIR / relative_path).resolve()
    if CONTENT_DIR.resolve() not in image_path.parents or not image_path.is_file():
        raise ConfigError("configured image does not exist")

    with image_path.open("rb") as image_file:
        validate_image_payload(image_file.read(MAX_IMAGE_BYTES + 1), source)

    player_path = CONTENT_DIR / "player.html"
    if not player_path.is_file():
        raise ConfigError("local image player does not exist")

    query = urlencode(
        {
            "image": relative_name,
            "revision": revision,
            "expectedWidth": source.get("expectedWidth", ""),
            "expectedHeight": source.get("expectedHeight", ""),
            "alt": source.get("alt", "Club display"),
        }
    )
    return f"{player_path.as_uri()}?{query}"


def slideshow_player_url(source: dict[str, Any], revision: str) -> str:
    slides = source.get("slides")
    duration = source.get("durationSeconds", 15)
    if not isinstance(slides, list) or not 1 <= len(slides) <= 50:
        raise ConfigError("image slideshow must contain 1–50 images")
    if isinstance(duration, bool) or not isinstance(duration, int) or not 3 <= duration <= 300:
        raise ConfigError("slide duration must be 3–300 seconds")
    prepared = []
    for slide in slides:
        if not isinstance(slide, dict) or slide.get("type") != "image":
            raise ConfigError("slideshow slides must be images")
        # Reuse the single-image path checks, cache, dimensions and checksum checks.
        query = dict(parse_qsl(urlparse(image_player_url(slide, revision)).query))
        prepared.append(query)
    query = urlencode({"slides": json.dumps(prepared, separators=(",", ":")),
                       "durationSeconds": duration, "revision": revision})
    return f"{(CONTENT_DIR / 'player.html').as_uri()}?{query}"


def source_url(source: dict[str, Any], revision: str) -> str:
    if source.get("type") == "image":
        return image_player_url(source, revision)
    if source.get("type") == "image_slideshow":
        return slideshow_player_url(source, revision)
    if source.get("type") == "google_slides":
        return google_slides_url(str(source.get("url", "")))
    raise ConfigError(f"unsupported source type: {source.get('type', 'missing')}")


def prepare_config(config: dict[str, Any]) -> None:
    """Stage every asset before replacing the persisted, playable configuration."""
    revision = str(config_revision(config))
    sources = [config["source"]]
    if config.get("mode", "manual") == "schedule":
        validate_schedule(config.get("schedule"))
        sources.append(config["schedule"]["fallback"]["source"])
        sources.extend(entry["source"] for entry in config["schedule"]["entries"])
    paths = set()
    total_bytes = total_pixels = 0
    for source in sources:
        source_url(source, revision)
        images = source.get("slides", []) if source.get("type") == "image_slideshow" else [source] if source.get("type") == "image" else []
        for image in images:
            query = dict(parse_qsl(urlparse(image_player_url(image, revision)).query))
            path = CONTENT_DIR / query["image"]
            if path not in paths:
                paths.add(path)
                with path.open("rb") as image_file:
                    payload = image_file.read(MAX_IMAGE_BYTES + 1)
                width, height = validate_image_payload(payload, image)
                total_bytes += len(payload)
                total_pixels += width * height
                if total_bytes > MAX_CONFIG_IMAGE_BYTES or total_pixels > MAX_CONFIG_IMAGE_PIXELS:
                    raise ConfigError("combined display images exceed player memory/storage limits")


def target_url(config: dict[str, Any]) -> str:
    return source_url(scheduled_source(config), str(config["revision"]))


def browser_command(url: str) -> list[str]:
    return [
        CHROMIUM,
        "--kiosk",
        "--noerrdialogs",
        "--disable-infobars",
        "--no-first-run",
        "--disable-session-crashed-bubble",
        "--disable-translate",
        "--disable-pinch",
        "--ash-hide-cursor-in-kiosk",
        "--hide-scrollbars",
        "--overscroll-history-navigation=0",
        "--enable-features=UseOzonePlatform",
        "--ozone-platform=wayland",
        "--disk-cache-dir=/var/cache/opencourt/chromium",
        "--user-data-dir=/var/cache/opencourt/chromium-profile",
        url,
    ]


def stop_browser(browser: subprocess.Popen[Any] | None) -> None:
    if browser is None or browser.poll() is not None:
        return
    browser.terminate()
    try:
        browser.wait(timeout=10)
    except subprocess.TimeoutExpired:
        browser.kill()
        browser.wait(timeout=5)


def request_stop(_signum: int, _frame: Any) -> None:
    STOP.set()


def main() -> int:
    signal.signal(signal.SIGTERM, request_stop)
    signal.signal(signal.SIGINT, request_stop)

    browser: subprocess.Popen[Any] | None = None
    active_revision: str | None = None
    active_url: str | None = None
    remote_etag: str | None = None
    poll_seconds = 60

    try:
        while not STOP.is_set():
            local_config: dict[str, Any] | None = None
            try:
                local_config = load_config()
                prepare_config(local_config)
                candidate_revision = str(local_config["revision"])
                candidate_url = target_url(local_config)
                poll_seconds = max(15, int(local_config.get("pollIntervalSeconds", 60)))

                if (
                    browser is None
                    or browser.poll() is not None
                    or candidate_revision != active_revision
                    or candidate_url != active_url
                ):
                    stop_browser(browser)
                    print(
                        f"OpenCourt: launching revision {candidate_revision} "
                        f"({scheduled_source(local_config)['type']})",
                        flush=True,
                    )
                    browser = subprocess.Popen(browser_command(candidate_url))
                    active_revision = candidate_revision
                    active_url = candidate_url
            except (ConfigError, json.JSONDecodeError, OSError, TypeError, ValueError) as error:
                print(f"OpenCourt: keeping last-known-good content: {error}", file=sys.stderr, flush=True)

            try:
                remote_settings = load_remote_settings()
                if remote_settings:
                    remote_config, candidate_etag = fetch_remote_config(remote_settings, remote_etag)
                    if remote_config is not None and remote_config != local_config:
                        require_newer_remote_revision(remote_config, local_config)
                        write_config_atomically(remote_config)
                        remote_etag = candidate_etag
                        print(
                            f"OpenCourt: accepted remote revision {remote_config['revision']}",
                            flush=True,
                        )
                        continue
                    remote_etag = candidate_etag
                    report_device_status(
                        remote_settings,
                        config_revision(local_config) if local_config else None,
                    )
            except (ConfigError, HTTPError, json.JSONDecodeError, OSError, TypeError, ValueError) as error:
                print(f"OpenCourt: remote update skipped: {error}", file=sys.stderr, flush=True)

            # Local watchdog health continues between cloud polls, including offline.
            deadline = time.monotonic() + poll_seconds
            while not STOP.is_set() and time.monotonic() < deadline:
                report_local_health(browser, active_url)
                STOP.wait(min(5, max(0, deadline - time.monotonic())))
    finally:
        stop_browser(browser)

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
