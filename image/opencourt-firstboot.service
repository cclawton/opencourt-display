[Unit]
Description=OpenCourt first-boot setup
After=systemd-user-sessions.service
Before=opencourt-kiosk.service
ConditionPathExists=!/var/lib/opencourt/setup-complete

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/opencourt-firstboot
StandardInput=tty-force
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
RemainAfterExit=yes

[Install]
WantedBy=default.target
