{
  "name": "opencourt-infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "seed": "node scripts/put-device-config.mjs",
    "seed-programmes": "node scripts/put-programmes.mjs",
    "migrate-content": "node scripts/migrate-content.mjs",
    "seed-legacy-schedule": "node scripts/seed-legacy-schedule.mjs",
    "backup": "node scripts/backup-control-plane.mjs",
    "restore": "node scripts/restore-control-plane.mjs",
    "test": "npm run build --silent && node --test test/*.test.mjs",
    "synth": "cdk synth"
  },
  "dependencies": {
    "@aws-sdk/client-cloudformation": "^3.1146.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1145.0",
    "@aws-sdk/client-dynamodb": "^3.883.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/lib-dynamodb": "^3.883.0",
    "@aws-sdk/s3-request-presigner": "^3.883.0",
    "aws-cdk-lib": "2.271.0",
    "aws-jwt-verify": "^5.2.1",
    "constructs": "10.8.1",
    "google-auth-library": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "aws-cdk": "2.1143.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3"
  }
}
